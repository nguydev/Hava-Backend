# GOODR HVAC backend — environment (copy to .env)
PORT=3000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/goodr-hvac

# JWT signing secret
JWT_SECRET=change-me

# Stripe (test mode). Secret key must stay server-side only.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
